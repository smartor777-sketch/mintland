#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	mkdir -p bin
	cc -O2 -Wall $(CPPFLAGS) $(CFLAGS) deskwall.c -lX11 -lXext -o bin/deskwall

override_dh_auto_clean:
	rm -f bin/deskwall

override_dh_fixperms:
	dh_fixperms
	if [ -f debian/mintland/usr/bin/mintland-launcher ]; then \
		mv debian/mintland/usr/bin/mintland-launcher debian/mintland/usr/bin/mintland; \
	fi
	chmod 755 debian/mintland/usr/bin/mintland
	chmod 755 debian/mintland/usr/lib/mintland/*.sh
	chmod 755 debian/mintland/usr/lib/mintland/bin/deskwall
